# =============================================================
# 5STAR CINEMATOGRAPHY - ROOT ENVIRONMENT TEMPLATE (.env.example)
# =============================================================

# --- FRONTEND (Vite / React) ---
VITE_API_BASE_URL=/api
VITE_SITE_URL=https://5starphotos.vercel.app

# --- BACKEND (Express / Serverless) ---
PORT=5000
NODE_ENV=development

# MongoDB Atlas Connection URI
# Replace with your actual MongoDB Atlas connection string:
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/5star_cinematography?retryWrites=true&w=majority

# JWT Authentication
JWT_SECRET=cinematic_5star_super_secret_jwt_key_2026_xyz987_prod_secure
JWT_EXPIRES_IN=7d

# CORS Allowed Origin
CLIENT_URL=http://localhost:5173

# Nodemailer / Transactional Emails (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_studio_email@gmail.com
SMTP_PASS=your_smtp_app_password
EMAIL_FROM="5Star Cinematography" <contact@5starcinematography.com>
ADMIN_NOTIFICATION_EMAIL=admin@5starcinematography.com

# Initial Default Administrator Setup Credentials
ADMIN_INITIAL_NAME="5Star Studio Director"
ADMIN_INITIAL_EMAIL=admin@5star.com
ADMIN_INITIAL_PASSWORD=Admin@5Star2026!
ADMIN_INITIAL_MOBILE=+91 9876543210

