# -------------------------------------------------------------
# 5STAR CINEMATOGRAPHY - BACKEND ENVIRONMENT CONFIGURATION
# -------------------------------------------------------------

# Server Port & Environment
PORT=5000
NODE_ENV=development

# MongoDB Atlas Connection URI
# Replace with your actual MongoDB Atlas connection string:
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database_name>?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://admin:admin123@cluster0.mongodb.net/5star_cinematography?retryWrites=true&w=majority

# JWT Authentication Secret & Expiration
JWT_SECRET=cinematic_5star_super_secret_jwt_key_2026_xyz987_prod_secure
JWT_EXPIRES_IN=7d

# Frontend Client URL (for CORS and QR link generation)
CLIENT_URL=http://localhost:5173

# Nodemailer / SMTP Configuration for Transactional Emails & Password Reset OTP
# For Gmail, use an App Password (not your normal account password):
# https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_studio_email@gmail.com
SMTP_PASS=your_smtp_app_password_here
EMAIL_FROM="5Star Cinematography" <contact@5starcinematography.com>
ADMIN_NOTIFICATION_EMAIL=admin@5starcinematography.com

# Initial Default Administrator Setup Credentials (used by scripts/createAdmin.js)
ADMIN_INITIAL_NAME="5Star Studio Director"
ADMIN_INITIAL_EMAIL=admin@5star.com
ADMIN_INITIAL_PASSWORD=Admin@5Star2026!
ADMIN_INITIAL_MOBILE=+91 98765 43210
